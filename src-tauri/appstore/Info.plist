<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fusionne dans l'Info.plist de la build Mac App Store seulement
  (bundle.macOS.infoPlist de tauri.appstore.conf.json ; volontairement pas
  dans src-tauri/, que Tauri fusionnerait dans toutes les builds).
  Chiffrement : HTTPS du systeme seulement, exempte.
-->
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
