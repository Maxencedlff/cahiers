<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Build Mac App Store (tauri.appstore.conf.json, job « mas » de build.yml).
  - app-sandbox : exige par l'App Store ;
  - application-identifier / team-identifier : ceux du profil de
    provisioning (doc Tauri « App Store ») ;
  - files.user-selected.read-write : dossier synchronise choisi dans la
    boite de dialogue, export Word « Enregistrer sous » ;
  - files.bookmarks.app-scope : retrouver ce dossier au lancement suivant
    (security-scoped bookmark, src-tauri/src/sandbox.rs) ;
  - network.client : reconnaissance d'ecriture MyScript (cloud.myscript.com,
    seulement si l'utilisateur a enregistre ses cles). Rien d'autre ne sort ;
  - print : export PDF (window.print, que Tauri passe a l'impression native
    de macOS, permission core:webview:allow-print de la capability).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>NMK739Z59B.fr.mdlf.cahiers</string>
	<key>com.apple.developer.team-identifier</key>
	<string>NMK739Z59B</string>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
