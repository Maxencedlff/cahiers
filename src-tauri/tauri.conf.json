{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cahiers",
  "version": "0.2.0",
  "identifier": "fr.mdlf.cahiers",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cahiers",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "maximized": true,
        "theme": "Light",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' https://cloud.myscript.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyN0YxNjlEQkRBQzQ5QjAKUldTd1NheTluUlovZ2tMaUxYUVowMDkrQ3VhcmF5OHJpeDg0aHhncUtRK0M4VFgraVFMK09wcDIK",
      "endpoints": [
        "https://github.com/Maxencedlff/cahiers-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
